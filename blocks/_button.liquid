{%- comment -%}
  Button in a Row (US-1.8, US-1.3): the closing call to action. Renders
  nothing until it has both a label and a link. Links can be pages, URLs or
  mailto: addresses.
{%- endcomment -%}
<div
  class="pf-button pf-button--{{ block.settings.alignment }}"
  style="--span: {{ block.settings.span }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.label != blank and block.settings.link != blank -%}
    <a href="{{ block.settings.link }}" class="btn btn--{{ block.settings.style }}">{{ block.settings.label }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .pf-button--center {
    text-align: center;
  }
  .pf-button--right {
    text-align: right;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Enquire" },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "A page, a web address, or mailto:you@example.com to open an email."
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "secondary", "label": "Secondary (outline)" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "span",
      "label": "Width (columns)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 6
    }
  ],
  "presets": [{ "name": "Button" }]
}
{% endschema %}
