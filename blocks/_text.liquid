{%- comment -%}
  Text in a Row (US-1.8, absorbs US-1.5). Paragraph style for the story;
  Statement style for the thesis line, in the display italic (as Series'
  statement band).
{%- endcomment -%}
<div
  class="pf-text pf-text--{{ block.settings.style }} pf-text--{{ block.settings.alignment }}"
  style="--span: {{ block.settings.span }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ block.settings.eyebrow }}</p>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    {%- if block.settings.heading_level == 'h1' -%}
      <h1 class="pf-text__heading">{{ block.settings.heading }}</h1>
    {%- else -%}
      <h2 class="pf-text__heading">{{ block.settings.heading }}</h2>
    {%- endif -%}
  {%- endif -%}
  {%- if block.settings.text != blank -%}
    <div class="pf-text__body">{{ block.settings.text }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .pf-text--center {
    text-align: center;
  }
  .pf-text__heading {
    margin-bottom: 2rem;
  }
  .pf-text--paragraph .pf-text__body p {
    font-size: 1.125rem;
    line-height: 2;
    margin-bottom: 1.25em;
  }
  .pf-text--paragraph .pf-text__body p:last-child {
    margin-bottom: 0;
  }
  .pf-text--statement .pf-text__body p {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.75rem, 4.5vw, 3.25rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    max-width: 20ch;
    text-wrap: balance;
    margin-bottom: 0.5em;
  }
  .pf-text--statement.pf-text--center .pf-text__body p {
    margin-left: auto;
    margin-right: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Text",
  "tag": null,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Heading" },
    {
      "type": "select",
      "id": "heading_level",
      "label": "Heading level",
      "info": "Use Page title once, for the main heading of the page.",
      "options": [
        { "value": "h2", "label": "Section heading" },
        { "value": "h1", "label": "Page title" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Tell the story of the work.</p>"
    },
    {
      "type": "select",
      "id": "style",
      "label": "Style",
      "options": [
        { "value": "paragraph", "label": "Paragraph" },
        { "value": "statement", "label": "Statement (large italic)" }
      ],
      "default": "paragraph"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "span",
      "label": "Width (columns)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    }
  ],
  "presets": [
    { "name": "Text" },
    {
      "name": "Statement",
      "settings": {
        "style": "statement",
        "alignment": "center",
        "heading": "",
        "text": "<p>One line that says what the work is about.</p>"
      }
    }
  ]
}
{% endschema %}
