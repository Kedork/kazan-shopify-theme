{%- comment -%}
  Kazan Studio — Announcement Bar

  One site-wide line for something time-boxed (a current exhibition, say).
  Lives in the header group, so it shows on every template. Switch it off or
  clear the text and nothing renders — no space is reserved.

  The header is position: fixed, so the bar is fixed too, above it. Its real
  height (it wraps on phones) goes into --announcement-h on <html>; base.css
  moves the header down and pads the page by that amount. With no bar the
  variable is unset and everything falls back to 0.
{%- endcomment -%}

{%- liquid
  assign show_bar = false
  if section.settings.show and section.settings.text != blank
    assign show_bar = true
  endif
-%}

{%- if show_bar -%}
  <style>
    /* First-paint estimate until the script below measures the real height. */
    :root { --announcement-h: 38px; }
    @media screen and (max-width: 600px) {
      :root { --announcement-h: 76px; }
    }

    .announcement-bar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1001;
    }
    .announcement-bar__inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: baseline;
      column-gap: 18px;
      row-gap: 2px;
      padding-top: 10px;
      padding-bottom: 10px;
      text-align: center;
    }
    .announcement-bar p {
      margin: 0;
    }
    .announcement-bar .eyebrow {
      letter-spacing: 0.24em;
      white-space: nowrap;
    }
    .announcement-bar__text {
      font-size: 0.8125rem;
      line-height: 1.4;
    }
    .announcement-bar__link {
      margin-left: 14px;
      text-decoration: underline;
      text-underline-offset: 3px;
      white-space: nowrap;
    }
  </style>

  <div class="announcement-bar scheme-{{ section.settings.ground }}" role="region" aria-label="Announcement" data-announcement-bar>
    <div class="announcement-bar__inner page-width">
      {%- if section.settings.label != blank -%}
        <p class="eyebrow">{{ section.settings.label }}</p>
      {%- endif -%}
      <p class="announcement-bar__text">
        {{- section.settings.text -}}
        {%- if section.settings.link != blank and section.settings.link_label != blank -%}
          <a class="announcement-bar__link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </p>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    var root = document.documentElement;
    var bar = document.querySelector('[data-announcement-bar]');
    function measure() {
      if (bar && bar.isConnected) {
        root.style.setProperty('--announcement-h', bar.offsetHeight + 'px');
      } else {
        root.style.removeProperty('--announcement-h');
      }
    }
    measure();
    if (bar && 'ResizeObserver' in window) {
      new ResizeObserver(measure).observe(bar);
    }
    // Theme editor: removing the section must give the space back.
    document.addEventListener('shopify:section:unload', function (event) {
      if (bar && event.target.contains(bar)) {
        bar = null;
        measure();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "section-announcement-bar",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    {
      "type": "checkbox",
      "id": "show",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Optional. A short eyebrow, e.g. \"On view\"."
    },
    {
      "type": "inline_richtext",
      "id": "text",
      "label": "Text",
      "info": "One line. Italics and links are allowed. Clear it (or untick Show) when the show closes and the bar disappears."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Details",
      "info": "Shown after the text when a link is set."
    },
    {
      "type": "select",
      "id": "ground",
      "label": "Background",
      "options": [
        { "value": "cobalt", "label": "Cobalt" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "cobalt"
    }
  ],
  "presets": [
    {
      "name": "Announcement bar"
    }
  ]
}
{% endschema %}
