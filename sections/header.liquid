{%- comment -%}
  Kazan Studio — Header Section
  Supports: logo, navigation, cart icon, mobile menu
{%- endcomment -%}

{%- liquid
  # The mark has a light and a dark variant; pick by how dark the scheme's
  # background is, so any scheme gets the readable one. Transparent sits over
  # the (dark) hero, so it always takes the light mark.
  assign logo_variant = 'dark'
  assign header_bg_brightness = section.settings.scheme.settings.background | color_brightness
  if header_bg_brightness < 128 or section.settings.transparent
    assign logo_variant = 'light'
  endif
-%}
<header
  class="site-header scheme color-{{ section.settings.scheme.id }}{% if section.settings.transparent %} site-header--transparent{% endif %}"
  data-header
  {% if section.settings.transparent %}data-transparent{% endif %}
>
  <div class="site-header__inner">
    <a href="/" class="site-header__logo" aria-label="{{ shop.name }}">
      {%- render 'logo-mark', variant: logo_variant -%}
      <span class="site-header__wordmark">KAZAN STUDIO</span>
    </a>

    <nav class="site-header__nav" aria-label="Main navigation">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- comment -%}
            Opens on hover and on :focus-within, so it works for keyboard users
            without any JS. On touch, tapping the parent follows its own link —
            which is why the parent needs a real destination, not a dead "#".
          {%- endcomment -%}
          <span class="site-header__item site-header__item--parent">
            <a href="{{ link.url }}" {% if link.active or link.child_active %}aria-current="page"{% endif %}>
              {{- link.title -}}
            </a>
            <span class="site-header__submenu">
              {%- for child in link.links -%}
                <a href="{{ child.url }}" {% if child.active %}aria-current="page"{% endif %}>
                  {{- child.title -}}
                </a>
              {%- endfor -%}
            </span>
          </span>
        {%- else -%}
          <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
      <a href="{{ routes.cart_url }}" class="site-header__cart" aria-label="Cart">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M5 5H19L17 13H7L5 5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M5 5L4 1H1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="8" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16" cy="17" r="1.5" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        {%- if cart.item_count > 0 -%}
          <span class="site-header__cart-count">{{ cart.item_count }}</span>
        {%- endif -%}
      </a>
    </nav>

    <button class="mobile-menu-toggle" data-mobile-toggle aria-label="Open menu" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<nav class="mobile-nav" data-mobile-nav aria-label="Mobile navigation">
  {%- for link in section.settings.menu.links -%}
    <a href="{{ link.url }}">{{ link.title }}</a>
    {%- comment -%}
      No disclosure to tap on mobile — children are simply listed under their
      parent, indented. One less thing between a visitor and the work.
    {%- endcomment -%}
    {%- for child in link.links -%}
      <a href="{{ child.url }}" class="mobile-nav__child">{{ child.title }}</a>
    {%- endfor -%}
  {%- endfor -%}
  <a href="{{ routes.cart_url }}">Cart ({{ cart.item_count }})</a>
</nav>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "color_scheme",
      "id": "scheme",
      "label": "Color scheme",
      "info": "The mobile menu always uses the page's Chalk scheme.",
      "default": "ink"
    },
    {
      "type": "checkbox",
      "id": "transparent",
      "label": "Transparent over the hero",
      "info": "Clear until the page scrolls, then the scheme's background. Only use with a dark hero first on the page.",
      "default": false
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Old color setting (no longer used)",
      "info": "Replaced by the color scheme above; this no longer does anything and will be removed.",
      "options": [
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" },
        { "value": "transparent", "label": "Transparent" }
      ],
      "default": "light"
    }
  ]
}
{% endschema %}
