{%- comment -%}
  Kazan Studio — 404 Section
{%- endcomment -%}

<section class="page-404 section-padding scheme color-{{ section.settings.color_scheme.id }}">
  <div class="page-width">
    <p class="eyebrow">404</p>
    <h1>Page Not Found</h1>
    <p>The page you are looking for does not exist or has been moved.</p>
    <a href="{{ routes.root_url }}" class="btn btn--secondary">Return Home</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "chalk"
    }
  ]
}
{% endschema %}
