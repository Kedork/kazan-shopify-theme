{%- comment -%}
  Kazan Studio — Main Cart Section
{%- endcomment -%}

<section class="cart-page section-padding">
  <div class="page-width">
    <div class="cart-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
    </div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post">
        {%- for item in cart.items -%}
          <div class="cart-item">
            <a href="{{ item.url }}" class="cart-item__image">
              {%- if item.image != blank -%}
                <img
                  src="{{ item.image | image_url: width: 200 }}"
                  alt="{{ item.title | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
            <div>
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- if item.variant.title != 'Default Title' -%}
                <p class="caption mt-1">{{ item.variant.title }}</p>
              {%- endif -%}
            </div>
            <span class="cart-item__price">{{ item.final_line_price | money_without_trailing_zeros }}</span>
            <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" class="cart-item__remove" aria-label="Remove {{ item.title }}">
              Remove
            </a>
          </div>
        {%- endfor -%}

        <div class="cart-totals">
          <div class="cart-totals__row">
            <span class="cart-totals__label">Subtotal</span>
            <span class="cart-totals__value">{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>
          <div class="cart-totals__row">
            <span class="cart-totals__label">Shipping</span>
            <span class="cart-totals__value caption">Calculated at checkout</span>
          </div>
          <div class="cart-totals__row cart-totals__row--total">
            <span class="cart-totals__label">Total</span>
            <span class="cart-totals__value" style="font-weight: 400;">{{ cart.total_price | money_without_trailing_zeros }}</span>
          </div>
          <button type="submit" name="checkout" class="btn btn--primary btn--full">Checkout</button>
          <div class="text-center mt-1">
            <a href="{{ section.settings.empty_button_url | default: routes.all_products_collection_url }}" style="font-size: 0.8125rem;">{{ section.settings.continue_label }}</a>
          </div>
        </div>
      </form>
    {%- else -%}
      <div class="cart-empty">
        <p class="body-large">{{ section.settings.empty_text }}</p>
        <a href="{{ section.settings.empty_button_url | default: routes.all_products_collection_url }}" class="btn btn--secondary">{{ section.settings.empty_button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Shopping"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Cart"
    },
    {
      "type": "text",
      "id": "continue_label",
      "label": "Continue-shopping link label",
      "default": "Continue Shopping"
    },
    {
      "type": "header",
      "content": "Empty cart"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty-cart message",
      "default": "Your cart is empty."
    },
    {
      "type": "text",
      "id": "empty_button_label",
      "label": "Empty-cart button label",
      "default": "Browse Work"
    },
    {
      "type": "url",
      "id": "empty_button_url",
      "label": "Shop link",
      "info": "Used by the empty-cart button and the continue-shopping link. Defaults to all products."
    }
  ]
}
{% endschema %}
