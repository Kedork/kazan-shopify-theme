{%- comment -%}
  Kazan Studio — The Details / FAQ Page
  Block-driven: each category heading and each question is an editor block,
  so content is fully editable in the theme customizer (no code edits).
{%- endcomment -%}

<section class="faq-page section-padding">
  <div class="page-width">

    <div class="faq-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
    </div>

    <div class="faq-page__body">
      {%- assign group_open = false -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'category' -%}
            {%- if group_open -%}</div></div>{%- endif -%}
            <div class="faq-section" {{ block.shopify_attributes }}>
              <h2 class="faq-section__heading">{{ block.settings.heading }}</h2>
              <div class="faq-items">
            {%- assign group_open = true -%}
          {%- when 'question' -%}
            {%- unless group_open -%}
              <div class="faq-section"><div class="faq-items">
              {%- assign group_open = true -%}
            {%- endunless -%}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <h3 class="faq-item__question">{{ block.settings.question }}</h3>
              <div class="faq-item__answer">{{ block.settings.answer }}</div>
            </div>
        {%- endcase -%}
      {%- endfor -%}
      {%- if group_open -%}</div></div>{%- endif -%}

      {%- if section.settings.cta != blank -%}
        <div class="faq-cta">{{ section.settings.cta }}</div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "FAQ page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Kazan Studio"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Details"
    },
    {
      "type": "richtext",
      "id": "cta",
      "label": "Closing call-to-action",
      "default": "<p>Still have questions? <a href=\"/pages/contact\">Get in touch.</a></p>"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Category"
        }
      ]
    },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Your question here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Your answer here.</p>"
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    {
      "name": "FAQ page"
    }
  ]
}
{% endschema %}
