{%- comment -%}
  Product Card Snippet
  Usage: {% render 'product-card', product: product %}

  Status badge (§08) — one per tile, top-left:
    New (coral)      → available + tag 'new'
    Edition (butter) → available + custom.edition metafield filled
    Sold (ink)       → unavailable + tag 'no-commission'
    Commission (line)→ unavailable + commissionable
{%- endcomment -%}

{%- liquid
  assign badge_label = ''
  assign badge_mod = ''
  if product.available
    if product.tags contains 'new'
      assign badge_label = 'New'
      assign badge_mod = 'new'
    elsif product.metafields.custom.edition.value != blank
      assign badge_label = 'Edition'
      assign badge_mod = 'edition'
    endif
  else
    if product.tags contains 'no-commission'
      assign badge_label = 'Sold'
      assign badge_mod = 'sold'
    else
      assign badge_label = 'Commission'
      assign badge_mod = 'commission'
    endif
  endif
-%}

<a href="{{ product.url }}" class="product-card">
  <div class="product-card__image">
    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 800 }}"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
        loading="lazy"
      >
    {%- endif -%}
    {%- if badge_label != blank -%}
      <span class="product-card__badge product-card__badge--{{ badge_mod }}">{{ badge_label }}</span>
    {%- endif -%}
  </div>
  <h3 class="product-card__title">{{ product.title }}</h3>
  <span class="product-card__price{% unless product.available %} product-card__price--sold{% endunless %}">{{ product.price | money_without_trailing_zeros }}</span>
</a>
