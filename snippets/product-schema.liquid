{%- comment -%}
  Kazan Studio — Product structured data
  Usage: {% render 'product-schema', product: product %}

  Emitted as a single node typed both Product and VisualArtwork. Product is
  what search engines read for price and availability; VisualArtwork is what
  these objects actually are, and carries the medium and surface that a
  generic Product type has nowhere to put.

  Dimensions come from three number metafields (custom.height / width / depth,
  in inches) and are published as separate QuantitativeValues. Each is emitted
  only when set, so a piece with no measurements publishes no size at all.
{%- endcomment -%}

{%- liquid
  assign variant = product.selected_or_first_available_variant

  if product.available
    assign availability = 'https://schema.org/InStock'
  else
    assign availability = 'https://schema.org/OutOfStock'
  endif

  assign plain_description = product.description | strip_html | strip_newlines | truncate: 5000
  assign material = product.metafields.custom.material.value
  assign glaze = product.metafields.custom.glaze.value
  assign technique = product.metafields.custom.technique.value
  assign dim_keys = 'height,width,depth' | split: ','
  assign year = product.metafields.custom.year.value
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": ["Product", "VisualArtwork"],
    "@id": {{ product.url | prepend: shop.url | append: '#product' | json }},
    "name": {{ product.title | json }},
    "description": {{ plain_description | json }},
    "url": {{ product.url | prepend: shop.url | json }},
    "sku": {{ variant.sku | default: variant.id | json }},
    {%- if product.featured_image != blank -%}
      "image": [
        {%- for media in product.media limit: 6 -%}
          {%- if media.media_type == 'image' -%}
            {{ media | image_url: width: 1600 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
          {%- endif -%}
        {%- endfor -%}
      ],
    {%- endif -%}
    "brand": {
      "@type": "Brand",
      "name": {{ shop.name | json }}
    },
    "creator": {
      "@type": "Person",
      "name": "Kevork Kazanjian"
    },
    "artform": "Ceramic",
    {%- if material != blank -%}
      "artMedium": {{ material | json }},
    {%- endif -%}
    {%- if glaze != blank -%}
      "artworkSurface": {{ glaze | json }},
    {%- endif -%}
    {%- if technique != blank -%}
      "creationTechnique": {{ technique | json }},
    {%- endif -%}
    {%- for dim_key in dim_keys -%}
      {%- assign dim = product.metafields.custom[dim_key].value -%}
      {%- if dim != blank -%}
        {{ dim_key | json }}: {
          "@type": "QuantitativeValue",
          "value": {{ dim | json }},
          "unitCode": "INH"
        },
      {%- endif -%}
    {%- endfor -%}
    {%- if year != blank -%}
      "dateCreated": {{ year | json }},
    {%- endif -%}
    "offers": {
      "@type": "Offer",
      "url": {{ product.url | prepend: shop.url | json }},
      "price": {{ product.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": {{ availability | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "seller": {
        "@type": "Organization",
        "name": {{ shop.name | json }}
      }
    }
  }
</script>
